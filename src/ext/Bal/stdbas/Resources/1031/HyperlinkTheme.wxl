<WixLocalization Culture="de-de" Language="1031" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="[WixBundleName]-Setup" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="Nach Updates wird gesucht" />
  <String Id="UpdateButton" Value="Auf Version [WixStdBAUpdateAvailable] &amp;aktualisieren" />
  <String Id="InstallHeader" Value="Willkommen" />
  <String Id="InstallMessage" Value="Setup wird [WixBundleName] auf Ihrem Computer installieren. Klicken Sie zum Fortfahren auf &quot;Installieren&quot; oder zum Beenden auf &quot;Abbrechen&quot;." />
  <String Id="InstallMessageOptions" Value="Setup wird [WixBundleName] auf Ihrem Computer installieren. Klicken Sie zum Fortfahren auf &quot;Installieren&quot;, zum Festlegen von Installationsoptionen auf &quot;Optionen&quot; oder zum Beenden auf &quot;Abbrechen&quot;." />
  <String Id="InstallVersion" Value="Version [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="Sind Sie sicher, dass Sie den Vorgang abbrechen möchten?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Vorherige Version" />
  <String Id="HelpHeader" Value="Setup-Hilfe" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [directory] - installiert, repariert, deinstalliert oder&#xA;   erstellt eine vollständige lokale Kopie des Bundles im Verzeichnis. &quot;/install&quot; ist der Standard.&#xA;&#xA;/passive | /quiet - zeigt eine minimale Benutzeroberfläche ohne Eingabeaufforderungen oder keine&#xA;   Benutzeroberfläche und keine Eingabeaufforderungen an. Standardmäßig werden die Benutzeroberfläche&#xA;   und alle Eingabeaufforderungen angezeigt.&#xA;&#xA;/norestart   - unterdrückt alle Neustartversuche. Standardmäßig fordert die Benutzeroberfläche vor einem Neustart dazu auf.&#xA;/log log.txt - protokolliert in einer bestimmten Datei. Standardmäßig wird eine Protokolldatei in %TEMP% erstellt." />
  <String Id="HelpCloseButton" Value="&amp;Schließen" />
