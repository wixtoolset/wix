  <String Id="ConfirmCancelMessage" Value="是否确实要取消?" />
  <String Id="HelpHeader" Value="安装程序帮助" />
  <String Id="HelpText" Value="/passive | /quiet -  显示最小的 UI 且无提示，或者不显示 UI 且&#xA;   无提示。默认情况下显示 UI 和所有提示。&#xA;&#xA;/norestart   - 隐藏任何重启提示。默认情况下 UI 会在重启前提示。&#xA;/log log.txt - 记录到特定文件。默认情况下在 %TEMP% 中创建日志文件。" />
  <String Id="HelpCloseButton" Value="关闭(&amp;C)" />
  <String Id="InstallLicenseTerms" Value="单击&quot;接受并安装&quot;按钮以接受必备组件&lt;a href=&quot;#&quot;&gt;许可条款&lt;/a&gt;。" />
  <String Id="InstallAcceptAndInstallButton" Value="接受并安装(&amp;A)" />
  <String Id="InstallDeclineButton" Value="拒绝(&amp;D)" />
  <String Id="ProgressHeader" Value="安装进度" />
  <String Id="ProgressLabel" Value="正在处理:" />
  <String Id="ProgressCancelButton" Value="取消(&amp;C)" />
  <String Id="SuccessHeader" Value="必备组件安装成功" />
  <String Id="SuccessLayoutHeader" Value="布局成功完成" />
  <String Id="SuccessRestartText" Value="必须重新启动计算机，然后 [WixBundleName] 安装程序才能继续。" />
