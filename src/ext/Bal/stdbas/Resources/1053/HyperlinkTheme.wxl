  <String Id="ConfirmCancelMessage" Value="Vill du avbryta?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Föregående version" />
  <String Id="HelpHeader" Value="Installationshjälp" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [directory] - installerar, reparerar, avinstallerar eller&#xA;   skapar en fullständig lokal kopia av paketet i katalogen. Installera är standard.&#xA;&#xA;/passive | /quiet - visar ett minimalt användargränssnitt utan frågor eller inget användargränssnitt&#xA;   och inga frågor. Som standard visas användargränssnittet och alla frågor.&#xA;&#xA;/norestart   - förhindrar alla försök till omstart. Som standard frågar användargränssnittet före omstart.&#xA;/log log.txt - loggar till en specifik fil. Som standard skapas en loggfil i %TEMP%." />
  <String Id="HelpCloseButton" Value="&amp;Stäng" />
