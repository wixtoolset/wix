<WixLocalization Culture="sv-se" Language="1053" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="[WixBundleName]-installation" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="Söker efter uppdateringar" />
  <String Id="UpdateButton" Value="&amp;Uppdatera till version [WixStdBAUpdateAvailable]" />
  <String Id="InstallHeader" Value="Välkommen" />
  <String Id="InstallMessage" Value="Installationsprogrammet kommer att installera [WixBundleName] på din dator. Klicka på Installera för att fortsätta eller Avbryt för att avsluta." />
  <String Id="InstallMessageOptions" Value="Installationsprogrammet kommer att installera [WixBundleName] på din dator. Klicka på Installera för att fortsätta, Alternativ för att ange installationsalternativ eller Avbryt för att avsluta." />
