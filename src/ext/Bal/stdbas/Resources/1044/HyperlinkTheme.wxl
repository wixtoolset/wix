  <String Id="ConfirmCancelMessage" Value="Er du sikker på at du vil avbryte?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Forrige versjon" />
  <String Id="HelpHeader" Value="Installasjonshjelp" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [directory] - installerer, reparerer, avinstallerer eller&#xA;   oppretter en fullstendig lokal kopi av pakken i katalogen. Installer er standard.&#xA;&#xA;/passive | /quiet - viser minimalt brukergrensesnitt uten spørsmål, eller viser ikke noe&#xA;   brukergrensesnitt og ingen spørsmål. Som standard vises brukergrensesnittet og alle spørsmål.&#xA;&#xA;/norestart   - undertrykker alle forsøk på omstart. Som standard spør brukergrensesnittet før omstart.&#xA;/log log.txt - skriver logg til en bestemt fil. Som standard opprettes en loggfil i %TEMP%." />
  <String Id="HelpCloseButton" Value="&amp;Lukk" />
