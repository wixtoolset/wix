  <String Id="Caption" Value="Instalator programu [WixBundleName]" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="Sprawdzanie aktualizacji" />
  <String Id="UpdateButton" Value="&amp;Aktualizuj do wersji [WixStdBAUpdateAvailable]" />
  <String Id="InstallHeader" Value="Witamy" />
  <String Id="InstallMessage" Value="Instalator zainstaluje program [WixBundleName] na komputerze. Kliknij przycisk Instaluj, aby kontynuować, lub Anuluj, aby zakończyć." />
  <String Id="InstallMessageOptions" Value="Instalator zainstaluje program [WixBundleName] na komputerze. Kliknij przycisk Instaluj, aby kontynuować, Opcje, aby ustawić opcje instalacji, lub Anuluj, aby zakończyć." />
  <String Id="InstallVersion" Value="Wersja [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="Czy na pewno chcesz anulować?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Poprzednia wersja" />
  <String Id="HelpHeader" Value="Pomoc instalatora" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [directory] - instaluje, naprawia, odinstalowuje lub&#xA;   tworzy pełną lokalną kopię pakietu w katalogu. Domyślną opcją jest instalacja.&#xA;&#xA;/passive | /quiet - wyświetla minimalny interfejs użytkownika bez monitów lub nie wyświetla interfejsu&#xA;   użytkownika ani monitów. Domyślnie wyświetlany jest interfejs użytkownika i wszystkie monity.&#xA;&#xA;/norestart   - pomija wszelkie próby ponownego uruchomienia. Domyślnie interfejs użytkownika wyświetla monit przed ponownym uruchomieniem.&#xA;/log log.txt - zapisuje dziennik w określonym pliku. Domyślnie plik dziennika jest tworzony w folderze %TEMP%." />
  <String Id="HelpCloseButton" Value="&amp;Zamknij" />
  <String Id="InstallLicenseLinkText" Value="&lt;a href=&quot;#&quot;&gt;Postanowienia licencyjne&lt;/a&gt; programu [WixBundleName]." />
