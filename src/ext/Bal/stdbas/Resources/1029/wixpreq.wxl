  <String Id="ProgressLabel" Value="Probíhá zpracování:" />
  <String Id="ProgressCancelButton" Value="&amp;Storno" />
  <String Id="SuccessHeader" Value="Instalace požadavků byla úspěšná" />
  <String Id="SuccessLayoutHeader" Value="Rozložení bylo úspěšně dokončeno" />
  <String Id="SuccessRestartText" Value="Před pokračováním instalace produktu [WixBundleName] je nutné restartovat počítač." />
  <String Id="SuccessRestartButton" Value="&amp;Restartovat" />
  <String Id="SuccessCloseButton" Value="&amp;Zavřít" />
  <String Id="FailureHeader" Value="Instalace se nezdařila" />
  <String Id="FailureLayoutHeader" Value="Rozložení se nezdařilo" />
  <String Id="FailureLogLinkText" Value="Byly zjištěny problémy, kvůli kterým se instalaci nepodařilo dokončit. Odstraňte tyto problémy a potom instalaci opakujte. Další informace naleznete v &lt;a href=&quot;#&quot;&gt;souboru protokolu&lt;/a&gt;." />
  <String Id="FailureRestartText" Value="Aby bylo možné vrácení změn softwaru dokončit, je nutné počítač restartovat." />
