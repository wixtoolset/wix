<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="CustomAction.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test passes the version of the DTF packages built alongside it. -->
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="$(DtfPackageVersion)" />
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller" Version="$(DtfPackageVersion)" />
  </ItemGroup>
</Project>
